// ORACLE-W1: shared helpers of the wave-1 areas (included once by wave1_oracle_test.cpp after the harness).
//
// Pattern ("Both"): the objects under test live at ONE address (a global at its exe address, or a test buffer) that both implementations get as `this` / argument.
// Per case: fill the ranges with random / poisoned data, snapshot -> run the port -> snapshot the result -> restore the snapshot -> run the exe -> compare return value and
// every byte range dword by dword (NaN-payload-only differences are classified by SameBits). Pointers stored into the objects are therefore identical on both sides.
#pragma once

struct Rg { uintptr_t va; size_t n; };

// random dwords with structure: zeros, small floats / ints, full random. NaN / Inf bit patterns are never produced (an exponent of all ones is turned into 0x3F): fixture floats are game
// states, and the C++ `>` / `max` of the port and the exe's x87 compare + fnstsw legitimately treat unordered operands differently (mask documented in .notes/reports/ORACLE-W1.md).
static uint32_t NoNaN(uint32_t v) { return (v & 0x7F800000u) == 0x7F800000u ? (v & ~0x40000000u) : v; }
#ifdef ORACLE_FAST_HELPERS   // tests/standalone/oracle_fast.cpp: the same code compiled /O2 (the targets are /Od /Ob0; this fill of the 128 KB scratch block was ~half of a case)
#include "oracle_fast.h"
#endif
static void FillGarbageRef(Rng& r, void* p, size_t n) {
    auto* w = static_cast<uint32_t*>(p);
    for (size_t i = 0; i + 4 <= n; i += 4) {
        uint32_t v;
        switch (r.below(8)) {
        case 0: v = 0; break;
        case 1: v = 0x80000000u; break;
        case 2: { const float f = GenF(r, 100.f, S_ZERO | S_DEN | S_TINY); std::memcpy(&v, &f, 4); break; }
        case 3: v = (uint32_t)r.below(256); break;
        case 4: { const float f = GenF(r, 3.f, S_ZERO | S_DEN | S_TINY); std::memcpy(&v, &f, 4); break; }
        default: v = NoNaN(r.u32() * 2654435761u); break;
        }
        w[i / 4] = v;
    }
}
static void FillGarbage(Rng& r, void* p, size_t n) {
#ifdef ORACLE_FAST_HELPERS
    if (oraclefast::FillGarbage(&r.s, r.sp, p, n)) g_special = true;
#else
    FillGarbageRef(r, p, n);
#endif
}
#ifdef ORACLE_FAST_HELPERS
// start-up check: the optimised fill produces the same bytes, the same Rng state and the same g_special as the reference
static struct FillSelfTest { FillSelfTest() {
    static uint8_t a[0x10000], b[0x10000];
    for (int sp : { 0, 30, 100 }) for (uint64_t seed = 1; seed <= 3; ++seed) {
        Rng ra(seed), rb(seed); ra.sp = rb.sp = sp; const bool sp0 = g_special; g_special = false;
        FillGarbageRef(ra, a, sizeof a); const bool refSpecial = g_special; g_special = false;
        const bool fastSpecial = oraclefast::FillGarbage(&rb.s, rb.sp, b, sizeof b); g_special = sp0;
        if (std::memcmp(a, b, sizeof a) != 0 || ra.s != rb.s || refSpecial != fastSpecial) { std::printf("oracle_fast: FillGarbage self-test FAILED (sp %d seed %d)\n", sp, (int)seed); std::abort(); }
    }
} } g_fillSelfTest;
#endif
// finite generators for game-state inputs (zeros, denormals, tiny values are still produced, NaN / Inf / huge are not)
static float GF(Rng& r, float scale) { return GenF(r, scale, S_ZERO | S_DEN | S_TINY); }
static CVector GVf(Rng& r, float scale) { return GenV(r, scale, S_ZERO | S_DEN | S_TINY); }
static void FillGarbage(Rng& r, uintptr_t va, size_t n) { FillGarbage(r, reinterpret_cast<void*>(va), n); }

// keeps the plain bool members of an object canonical (0/1) after FillGarbage: the exe tests some flags with `cmp byte,0` and others with `cmp byte,1` / `sete`, so a bool of 2..255 is UB for the
// port and makes the two sides legitimately differ (found with CCamera::SetWideScreenOff / ProcessFade). Tables: wave1_oracle_bools.inc (generated by tools/gen_bool_offsets.py).
template<size_t N> static void FixBools(Rng& r, void* obj, const std::pair<size_t, size_t> (&tab)[N]) {
    for (const auto& [off, n] : tab) for (size_t i = 0; i < n; ++i) static_cast<uint8_t*>(obj)[off + i] = (uint8_t)r.below(2);
}

static uint64_t RB(bool b)  { return b ? 1u : 0u; }
static uint64_t RF(float f) { return FBits(f); }
template<class T> static uint64_t RI(T v) { return (uint64_t)(int64_t)v; }

static std::string RangeDiff(const std::vector<uint8_t>& a, uintptr_t cur, size_t n, const char* tag) { return DiffDesc(a.data(), reinterpret_cast<void*>(cur), n, tag); }

// fl = the return value is a float (bit compare through SameBits so NaN payloads are classified)
template<bool Fl = false, class PF, class EF>
static bool Both(std::string& d, std::initializer_list<Rg> rgs, PF&& portFn, EF&& exeFn, const std::string& ctx = {}) {
    std::vector<std::vector<uint8_t>> in, pa;
    for (const auto& g : rgs) { in.emplace_back(g.n); std::memcpy(in.back().data(), (void*)g.va, g.n); }
    const uint64_t ra = portFn();
    Hit(ra != 0);   // coverage: how often the result is non-zero
    for (const auto& g : rgs) { pa.emplace_back(g.n); std::memcpy(pa.back().data(), (void*)g.va, g.n); }
    { size_t i = 0; for (const auto& g : rgs) std::memcpy((void*)g.va, in[i++].data(), g.n); }
    const uint64_t re = exeFn();
    bool ok = Fl ? SameBits((uint32_t)ra, (uint32_t)re) : ra == re;
    { size_t i = 0; for (const auto& g : rgs) { ok &= SameBlob(pa[i].data(), (void*)g.va, g.n); ++i; } }
    if (ok) return true;
    d = ctx + " ret got " + (Fl ? F(BitsF((uint32_t)ra)) : std::to_string((long long)ra)) + " exe " + (Fl ? F(BitsF((uint32_t)re)) : std::to_string((long long)re));
    { size_t i = 0; for (const auto& g : rgs) { d += RangeDiff(pa[i], g.va, g.n, ("m" + std::to_string(i)).c_str()); ++i; } }
    return false;
}

// bool / small-int arguments to exe functions are passed as clean dwords (game_oracle.h, ARGUMENT WIDTH)
template<class T> static int W(T v) { return (int)v; }

// constant-returning overrides (generated rows, see tools/gen_const_rows.py): the port's definition and the exe's function get the same garbage-filled `this`
namespace w1k {
alignas(16) inline uint8 obj[0x400];
template<class T> inline bool Same(T a, T b) { if constexpr (std::is_floating_point_v<T>) return SameF(a, b); else return a == b; }
template<class T> inline std::string Str(T v) { if constexpr (std::is_floating_point_v<T>) return F(v); else return std::to_string((long long)v); }
template<class T, class PF, class EF> inline void Case(const char* name, PF pf, EF ef) {
    Run(name, [=](Rng& r, std::string& d) {
        FillGarbage(r, obj, sizeof obj);
        const T a = pf(static_cast<void*>(obj)), e = ef(static_cast<void*>(obj));
        if (Same<T>(a, e)) return true;
        d = std::string("got ") + Str<T>(a) + " exe " + Str<T>(e);
        return false;
    }, 16);
}
}
